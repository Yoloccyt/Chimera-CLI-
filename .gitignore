# Chimera CLI NEXUS-OMEGA — .gitignore
# 排除编译产物、工具链缓存、临时文件,避免误纳敏感文件

# === Rust 编译产物 ===
target/
target_clippy*/
**/*.rs.bk
*.pdb

# === Rust 工具链缓存(本地迁移至 D 盘)===
.toolchain/

# === 临时文件 ===
tmp/
tmp_podman/
%SystemDrive%/
*.tmp
*.temp
*.log

# === Git Worktrees ===
.worktrees/

# === IDE / 编辑器 ===
.idea/
.vscode/
.qoder/
*.swp
*.swo
*~

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 环境与密钥(禁止提交)===
.env
.env.*
*.pem
*.key
secrets/

# === 文档二进制(非源码)===
*.docx
*.pdf

# === 发布构建产物 ===
dist/
*.exe
*.zip

# === 文档/规格/规则文件 — 本地保留，不入远程仓库 ===
*.md
.claude/
.trae/



# === Python 缓存 ===
__pycache__/
*.pyc

# lychee link checker cache
.lycheecache

# === NMC 模型资产 —— 二进制不入库（许可/体积;WI-C2/ADR-196 D4）===
# 获取路径/SHA-256 清单见 assets/nmc/manifest.toml;
# 下载/校验由 scripts/fetch_nmc_assets.{ps1,sh} 执行。
assets/nmc/models/
