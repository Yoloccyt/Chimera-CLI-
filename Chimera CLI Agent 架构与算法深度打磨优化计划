### 6.3 MCP 协议集成

```rust
/// MCP (Model Context Protocol) 客户端
/// 
/// 设计目标：
/// 1. 工具即插即用（无需重新编译 Chimera）
/// 2. Workspace 级连接池复用
/// 3. 动态 schema 发现
/// 4. 与 Nexus MoE Router 深度集成
pub struct McpClientV2 {
    transport_pool: McpTransportPool,
    tool_registry: McpToolRegistry,
    schema_cache: McpSchemaCache,
    router_integration: McpRouterIntegration,
}

impl McpClientV2 {
    /// 动态发现工具（与 MoE Router 协同）
    pub async fn discover_and_register(&self) -> Result<(), McpError> {
        // 1. 从所有已配置的 MCP 服务器获取工具列表
        let all_tools = self.transport_pool.list_all_tools().await?;

        // 2. 为每个工具生成语义嵌入（用于 MoE 路由）
        for tool in &all_tools {
            let embedding = self.generate_tool_embedding(tool).await?;

            // 3. 注册到 MoE Router
            self.router_integration.register_expert(ExpertSpec {
                id: ExpertId::from(&tool.name),
                name: tool.name.clone(),
                description: tool.description.clone(),
                embedding,
                category: classify_tool_category(tool),
            }).await?;

            // 4. 缓存 schema
            self.schema_cache.store(tool.name.clone(), tool.schema.clone()).await?;
        }

        Ok(())
    }

    /// 执行工具调用（与事件总线集成）
    pub async fn execute(&self, call: McpToolCall) -> Result<ToolResult, McpError> {
        // 1. 获取传输连接（从连接池）
        let transport = self.transport_pool.acquire(&call.server_name).await?;

        // 2. 发送调用请求
        let result = transport.call_tool(call.name, call.arguments).await?;

        // 3. 将结果转换为 NexusEvent
        let event = NexusEventV2::ToolResult(ToolResultEvent {
            tool_name: call.name,
            output: result.content,
            is_error: result.is_error,
            metadata: EventMetadataV2 {
                // 自动提取关键符号用于 IndexShare
                key_symbols: extract_symbols(&result.content),
                ..Default::default()
            },
        });

        // 4. 发布到事件总线
        self.event_bus.publish(event).await?;

        Ok(result)
    }
}
